# Public website origin, no trailing slash. Use HTTPS for production.
APP_ORIGIN=http://localhost:12000
DIRECTUS_URL=http://localhost:12001
# Generate independent secrets: openssl rand -hex 32
SESSION_SECRET=
DIRECTUS_SECRET=
ARCHIVE_TOKEN=
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Production: create a Cloudflare Turnstile widget for your public hostname.
# Local development only: set TURNSTILE_MODE=test with a localhost APP_ORIGIN.
TURNSTILE_MODE=production
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional; only needed for docker compose --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=
