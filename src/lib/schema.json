{
  "airports": {"label":"空港", "fields": {
    "name":{"label":"空港名","type":"string","required":true},
    "iata":{"label":"IATAコード","type":"string"},
    "icao":{"label":"ICAOコード","type":"string"},
    "country":{"label":"国・地域","type":"string"},
    "latitude":{"label":"緯度","type":"float","required":true},
    "longitude":{"label":"経度","type":"float","required":true},
    "timezone":{"label":"タイムゾーン (Asia/Tokyoなど)","type":"string","required":true}
  }},
  "airlines": {"label":"航空会社", "fields": {
    "name":{"label":"航空会社名","type":"string","required":true},
    "iata":{"label":"IATAコード","type":"string"},
    "icao":{"label":"ICAOコード","type":"string"}
  }},
  "aircraft_types": {"label":"機種", "fields": {
    "name":{"label":"機種名","type":"string","required":true},
    "manufacturer":{"label":"メーカー","type":"string"},
    "icao":{"label":"ICAO機種コード","type":"string"}
  }},
  "aircraft": {"label":"航空機", "fields": {
    "registration":{"label":"現在の機体番号","type":"string","required":true},
    "serial_number":{"label":"製造番号","type":"string"},
    "type":{"label":"機種","type":"uuid","relation":"aircraft_types"},
    "airline":{"label":"現在の航空会社","type":"uuid","relation":"airlines"},
    "notes":{"label":"機体情報・履歴","type":"text"}
  }},
  "aircraft_history": {"label":"機体番号・所属履歴", "fields": {
    "aircraft":{"label":"航空機","type":"uuid","relation":"aircraft","required":true},
    "registration":{"label":"当時の機体番号","type":"string","required":true},
    "airline":{"label":"当時の航空会社","type":"uuid","relation":"airlines"},
    "start_date":{"label":"開始日","type":"date"},
    "end_date":{"label":"終了日","type":"date"}
  }},
  "categories": {"label":"写真カテゴリー", "fields": {
    "name":{"label":"カテゴリー名","type":"string","required":true}
  }},
  "flights": {"label":"フライト", "fields": {
    "import_source":{"label":"インポート元","type":"string","hidden":true},
    "flight_number":{"label":"便名","type":"string","required":true},
    "status":{"label":"状態","type":"string","required":true,"options":["planned","flown","cancelled","not_taken"]},
    "origin":{"label":"出発空港","type":"uuid","relation":"airports","required":true},
    "destination":{"label":"到着空港","type":"uuid","relation":"airports","required":true},
    "scheduled_departure":{"label":"予定出発日時（出発空港の現地時刻）","type":"timestamp"},
    "scheduled_arrival":{"label":"予定到着日時（到着空港の現地時刻）","type":"timestamp"},
    "actual_departure":{"label":"実際の出発日時（出発空港の現地時刻）","type":"timestamp"},
    "actual_arrival":{"label":"実際の到着日時（到着空港の現地時刻）","type":"timestamp"},
    "airline":{"label":"航空会社","type":"uuid","relation":"airlines"},
    "airline_name":{"label":"当時の航空会社名（未入力なら初回保存時に補完）","type":"string"},
    "aircraft":{"label":"搭乗機","type":"uuid","relation":"aircraft"},
    "registration":{"label":"当時の機体番号（未入力なら初回保存時に補完）","type":"string"},
    "seat":{"label":"座席","type":"string"},
    "cabin":{"label":"搭乗クラス","type":"string"},
    "notes":{"label":"公開メモ","type":"text"}
  }},
  "photos": {"label":"写真", "fields": {
    "title":{"label":"タイトル","type":"string","required":true},
    "file":{"label":"画像ファイル","type":"uuid","relation":"directus_files","required":true},
    "visibility":{"label":"公開範囲","type":"string","required":true,"options":["public","private"]},
    "category":{"label":"カテゴリー","type":"uuid","relation":"categories"},
    "tags":{"label":"タグ（カンマ区切り）","type":"json"},
    "taken_on":{"label":"撮影日","type":"date"},
    "location":{"label":"撮影場所","type":"string"},
    "airport":{"label":"空港","type":"uuid","relation":"airports"},
    "aircraft":{"label":"航空機","type":"uuid","relation":"aircraft"},
    "registration":{"label":"撮影時の機体番号","type":"string"},
    "flight":{"label":"関連フライト","type":"uuid","relation":"flights"},
    "description":{"label":"説明","type":"text"}
  }}
}
